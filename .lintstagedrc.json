{
  "realtime_ai_whiteboard/bff-api/**/*.ts": [
    "prettier --write",
    "eslint --fix"
  ],
  "realtime_ai_whiteboard/web-app/**/*.{ts,tsx}": [
    "prettier --write",
    "eslint --fix"
  ],
  "realtime_ai_whiteboard/ai-service/**/*.py": [
    "python3 -m ruff check --fix",
    "python3 -m ruff format"
  ],
  "realtime_ai_whiteboard/mobile-app/**/*.{ts,tsx}": [
    "prettier --write"
  ],
  "3d_asset_collaboration/mobile-app/**/*.{ts,tsx}": [
    "prettier --write"
  ],
  "enterprise_workflow_system/workflow-api/**/*.kt": [
    "bash -c 'cd enterprise_workflow_system/workflow-api && ./gradlew ktlintFormat'"
  ],
  "enterprise_workflow_system/employee-portal/**/*.{ts,tsx,vue}": [
    "prettier --write"
  ],
  "enterprise_workflow_system/admin-dashboard/**/*.{ts,tsx,vue}": [
    "prettier --write"
  ],
  "enterprise_workflow_system/notification-worker/**/*.kt": [
    "bash -c 'cd enterprise_workflow_system/notification-worker && ./gradlew ktlintFormat'"
  ],
  "3d_asset_collaboration/asset-portal/**/*.{ts,tsx}": [
    "prettier --write"
  ],
  "3d_asset_collaboration/ai-service/**/*.py": [
    "python3 -m ruff check --fix",
    "python3 -m ruff format"
  ]
}
