# ──────────────────────────────────────────────
# Enterprise Workflow System - Environment Config
# Copy to .env and update values for your environment
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=workflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=workflow_db
POSTGRES_PORT=5433

# Redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6381

# Kafka
KAFKA_PORT=9095

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# MinIO
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# Unleash
UNLEASH_PORT=4243
UNLEASH_DB=unleash_db
UNLEASH_ADMIN_TOKEN=CHANGE_ME

# MailHog
MAILHOG_SMTP_PORT=1026
MAILHOG_UI_PORT=8026
